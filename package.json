{
  "name": "sierra-club-huts",
  "version": "1.0.0",
  "description": "Sierra Club hut reservation and lottery app",
  "main": "src/server.js",
  "scripts": {
    "test:ses-mail": "node scripts/sesMailTest.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:summary": "node scripts/requestSummaryTest.js",
    "test:migration": "node scripts/sqliteMigrationTest.js",
    "test:mode": "node scripts/appModeTest.js",
    "test:assignment-status": "node scripts/assignmentStatusTest.js",
    "test:assignment-lottery-flag": "node scripts/assignmentLotteryFlagTest.js",
    "test:assignment-preference": "node scripts/assignmentPreferenceOrderTest.js",
    "test:profile": "node scripts/profileAccessTest.js",
    "test:trip-request": "node scripts/tripRequestVerificationTest.js",
    "test:work-party": "node scripts/workPartySignupTest.js",
    "test:admin-console": "node scripts/adminConsoleOrganizationTest.js",
    "test:admin-volunteers": "node scripts/adminVolunteerManagementTest.js",
    "test:admin-work-parties": "node scripts/adminWorkPartyManagementTest.js",
    "test:liability-waivers": "node scripts/liabilityWaiverReviewTest.js",
    "test:smoke": "node scripts/browserSmokeTest.js",
    "test:standalone": "node scripts/standaloneAppTest.js",
    "test:login-agreements": "node scripts/loginAgreementsTest.js",
    "test:credits": "node scripts/fractionalCreditsTest.js",
    "test:contention": "node scripts/contentionCalculationTest.js && node scripts/contentionPersistenceTest.js",
    "test:contention-alerts": "node scripts/contentionAlertTest.js && node scripts/contentionAlertApiTest.js",
    "alerts:contention": "node scripts/contentionAlerts.js",
    "test:allocation": "node scripts/allocationOptimizationTest.js && node scripts/allocationPersistenceTest.js",
    "benchmark:allocation": "node scripts/allocationBenchmark.js",
    "test:allocation-browser": "node scripts/allocationBrowserTest.js",
    "test:reservations": "node scripts/placeholderReservationsTest.js",
    "test:reservations-browser": "node scripts/placeholderReservationsBrowserTest.js"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1146.0",
    "express": "^4.22.1",
    "express-session": "^1.18.0",
    "highs": "1.15.3",
    "multer": "^1.4.5-lts.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wisterw/Sierra-Club-Huts.git"
  },
