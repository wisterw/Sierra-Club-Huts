  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/wisterw/Sierra-Club-Huts/issues"
  },
  "homepage": "https://github.com/wisterw/Sierra-Club-Huts#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
